# Copy to .env.local for local development (it's git-ignored),
# and add the same variables in Vercel → Project → Settings → Environment Variables.

# Free Google Gemini API key for the AI assistant (app/api/chat/route.ts).
# Get one at https://aistudio.google.com/apikey — no credit card needed.
# Without it the chat widget shows a WhatsApp-only fallback.
GEMINI_API_KEY=

# Optional: override the model (defaults to "gemini-flash-lite-latest").
# GEMINI_MODEL=
